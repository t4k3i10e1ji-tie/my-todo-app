# Copy this file to `.env` and replace the placeholders with your real connection strings.
# Connection strings for PostgreSQL.
# Requires PostgreSQL >= 15.

# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Direct (non-pooled) connection, used by the Prisma CLI for migrations and contract emit.
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"
